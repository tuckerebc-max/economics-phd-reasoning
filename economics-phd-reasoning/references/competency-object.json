      "layer": "EVALUATOR_DESIGN",
      "rule": "Do not reward causal language when identification does not support it."
    }
  ],
  "performance_levels": [
    {
      "level": "emerging",
      "description": "presents a model or result with limited assumptions or evidence alignment"
    },
    {
      "level": "proficient",
      "description": "aligns contribution, assumptions, methods, evidence, and interpretation"
    },
    {
      "level": "transfer",
      "description": "repairs a plausible but invalid identification strategy and narrows the claim"
    }
  ],
  "failure_modes": [
    {
      "id": "FM1",
      "name": "model-as-reality"
