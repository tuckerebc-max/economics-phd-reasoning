  "constraints": [
    {
      "id": "C1",
      "constraint": "field variation remains visible"
    },
    {
      "id": "C2",
      "constraint": "no invented data, coefficients, or literature"
    },
    {
      "id": "C3",
      "constraint": "discipline methods review for technical examples"
    }
  ],
  "risk_considerations": [
    {
      "risk": "misleading policy inference",
      "control": "claim-type and identification check"
    },
    {
      "risk": "methodological monoculture",
      "control": "multiple traditions and exemplars"
    }
  ],
  "agent_instructions": {
    "allowed_role": "check algebra, code, assumptions, and alternative specifications",
    "must_do": [
      "state claim type",
      "show assumptions",
      "test robustness",
      "surface unidentifiable claims"
    ],
    "must_not_do": [
      "invent results",
      "declare causal inference without basis",
      "flatten subfields"
    ],
    "human_accountability": "researcher owns contribution and substantive interpretation"
  },
  "evaluator_checks": [
